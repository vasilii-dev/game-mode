<Window x:Class="GameMode.Windows.UI.AuthorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:GameMode.Windows.UI"
        Title="Game Mode — авторы" Width="630" Height="540" MinWidth="540" MinHeight="470"
        WindowStartupLocation="CenterOwner" Background="#090909" Foreground="#F0F0F0"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <ScrollViewer Background="#090909" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                <ui:MaterialIcon Kind="group" Width="29" Height="29" Margin="0,0,12,0"/>
                <StackPanel><TextBlock Text="Авторы" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Люди за Game Mode" FontSize="13" Foreground="#AAAAAA" Margin="0,4,0,0"/></StackPanel>
            </StackPanel>
            <Border Background="#141414" BorderBrush="#242424" BorderThickness="1" CornerRadius="22" Padding="22">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="122" Height="122" CornerRadius="20" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="#454545" BorderThickness="1">
                        <Border.Background><ImageBrush ImageSource="../Assets/Brand/vasilii-dev.png" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Border.Background>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="vasilii-dev" FontSize="28" FontWeight="SemiBold"/>
                        <Border Background="#1A3021" CornerRadius="12" Padding="10,5" HorizontalAlignment="Left" Margin="0,10,0,12"><TextBlock Text="Автор проекта" Foreground="#ADDFB8" FontSize="11"/></Border>
                        <TextBlock Text="Идея Game Mode, авторские иконки и тексты приложения." TextWrapping="Wrap" Foreground="#BBBBBB" FontSize="13" LineHeight="20"/>
                        <Button Click="OpenProfile_Click" HorizontalAlignment="Left" Margin="0,15,0,0" Padding="11,8" AutomationProperties.Name="Открыть профиль vasilii-dev на GitHub">
                            <StackPanel Orientation="Horizontal"><ui:MaterialIcon Kind="open_in_new" Width="16" Height="16" Margin="0,0,7,0"/><TextBlock Text="Профиль на GitHub" FontSize="12"/></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Text="Спасибо, что пользуетесь Game Mode." FontSize="17" FontWeight="SemiBold" Margin="0,23,0,7"/>
            <TextBlock Text="Звезда на GitHub и понятные сообщения об ошибках помогают развитию проекта." FontSize="13" Foreground="#AAAAAA" TextWrapping="Wrap" LineHeight="21"/>
            <DockPanel Margin="0,18,0,0">
                <Button Click="Close_Click" Content="Закрыть" DockPanel.Dock="Right" Padding="16,9" Margin="10,0,0,0"/>
                <Button Click="OpenProject_Click" Padding="16,9" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><ui:MaterialIcon Kind="open_in_new" Width="16" Height="16" Margin="0,0,7,0"/><TextBlock Text="Game Mode на GitHub" FontSize="12"/></StackPanel></Button>
            </DockPanel>
            <TextBlock Text="Служебные значки: Google Material Symbols · Apache 2.0" FontSize="10" Foreground="#AAAAAA" Margin="0,21,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Window>
