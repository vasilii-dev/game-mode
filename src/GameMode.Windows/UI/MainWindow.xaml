<Window x:Class="GameMode.Windows.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:GameMode.Windows.UI"
        Title="Game Mode — настройки" Width="1240" Height="920"
        MinWidth="960" MinHeight="760" WindowStartupLocation="CenterScreen"
        Background="#060606" Foreground="#F0F0F0" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#AAAAAA"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="Background" Value="#242424"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.66"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#E3E3E3"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1B1B1B"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="CaretBrush" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#4B4B4B"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="SelectionBrush" Value="#496C54"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Margin="1" Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbSurface" Background="#4B4B4B" CornerRadius="4"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#707070"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#999999"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar"><Grid Margin="1" Background="Transparent"><Track x:Name="PART_Track" Orientation="Horizontal">
                                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb MinWidth="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#4B4B4B" CornerRadius="4"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                            </Track></Grid></ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="17,11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface" Background="{TemplateBinding Background}" CornerRadius="15" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#F0F0F0"/><Setter TargetName="TabSurface" Property="Background" Value="#2B2B2B"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#222222"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="#E3E3E3"/><Setter TargetName="TabSurface" Property="BorderThickness" Value="1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#222222"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="18" ShadowDepth="4" RenderingBias="Performance"/></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop x:Name="BackgroundStart" Color="#16090A"/><GradientStop x:Name="BackgroundEnd" Color="#060606" Offset="1"/></LinearGradientBrush></Grid.Background>
        <Image x:Name="BackgroundArtwork" Source="../Assets/Brand/off.png" Opacity="0.055" Stretch="UniformToFill" IsHitTestVisible="False"/>
        <Grid Margin="22,16,22,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="182"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="13" Margin="0,0,12,0"><Border.Background><ImageBrush ImageSource="../Assets/Brand/Icon.png"/></Border.Background></Border>
                    <TextBlock Text="Game Mode" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border CornerRadius="18" Background="#262626" Padding="14,9" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal"><ui:MaterialIcon Kind="home" Width="17" Height="17" Margin="0,0,7,0"/><TextBlock Text="Главная" FontWeight="SemiBold" FontSize="13"/></StackPanel>
                    </Border>
                    <Button Click="ShowAuthors_Click" Background="Transparent" BorderThickness="0" Padding="13,9" ToolTip="Авторы Game Mode · отдельное окно">
                        <StackPanel Orientation="Horizontal"><ui:MaterialIcon Kind="group" Width="17" Height="17" Fill="#BBBBBB" Margin="0,0,7,0"/><TextBlock Text="Авторы" Foreground="#BBBBBB" FontSize="13"/></StackPanel>
                    </Button>
                    <Button Click="OpenProject_Click" Background="Transparent" BorderThickness="0" Padding="13,9" ToolTip="Открыть проект на GitHub">
                        <StackPanel Orientation="Horizontal"><ui:MaterialIcon Kind="open_in_new" Width="17" Height="17" Fill="#BBBBBB" Margin="0,0,7,0"/><TextBlock Text="GitHub" Foreground="#BBBBBB" FontSize="13"/></StackPanel>
                    </Button>
                </StackPanel>
                <Border x:Name="HeaderBadge" Grid.Column="2" CornerRadius="17" Background="#281517" Padding="13,9" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><Ellipse x:Name="HeaderDot" Width="7" Height="7" Fill="#FF8B8B" Margin="0,0,8,0"/><TextBlock x:Name="HeaderState" Text="Принудительно выключен" FontSize="12"/></StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="348"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="ModeCard" Style="{StaticResource Card}" Padding="22,18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="76" Height="76" CornerRadius="18" VerticalAlignment="Top"><Border.Background><ImageBrush x:Name="StateArtwork" ImageSource="../Assets/Brand/off.png"/></Border.Background></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="ВАШ РЕЖИМ" FontSize="10" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Время играть." FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    <TextBlock Text="Остальное — под контролем" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="StateTitle" Text="Принудительно выключен" FontSize="19" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock x:Name="StateExplanation" Text="Включите режим. Он будет ждать запуска игры." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,12" MinHeight="34"/>
                            <Button x:Name="ModeButton" Height="76" Click="ModeButton_Click" Padding="10" Background="#392021" BorderThickness="0" AutomationProperties.Name="Включить или отключить Game Mode" ToolTip="Включает ожидание игры или принудительно отключает режим">
                                <StackPanel HorizontalAlignment="Center">
                                    <ui:MaterialIcon Kind="power_settings_new" Width="25" Height="25" Margin="0,0,0,7"/>
                                    <TextBlock x:Name="ModeButtonLabel" Text="Включить Game Mode" FontSize="17" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Grid Margin="0,12,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Background="#1B1B1B" CornerRadius="13" Padding="12"><StackPanel><TextBlock x:Name="ReleasedMemory" Text="0 МиБ" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Working Set закрытых" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></Border>
                                <Border Grid.Column="2" Background="#1B1B1B" CornerRadius="13" Padding="12"><StackPanel><TextBlock x:Name="ClosedPrograms" Text="0" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Процессов закрыто" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></Border>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><ui:MaterialIcon Kind="settings" Width="17" Height="17" Fill="#AAAAAA" Margin="0,0,7,0"/><TextBlock Text="Как работает режим" FontSize="13" FontWeight="SemiBold"/></StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><Label Content="Порог, _МиБ" Target="{Binding ElementName=ThresholdInput}" Foreground="#BBBBBB" Padding="0,0,0,5" FontSize="11"/><TextBox x:Name="ThresholdInput" Text="200" LostFocus="NumericSetting_LostFocus" KeyDown="NumericSetting_KeyDown" AutomationProperties.Name="Порог памяти в МиБ"/></StackPanel>
                                <StackPanel Grid.Column="2"><Label Content="Интервал, _сек" Target="{Binding ElementName=IntervalInput}" Foreground="#BBBBBB" Padding="0,0,0,5" FontSize="11"/><TextBox x:Name="IntervalInput" Text="10" LostFocus="NumericSetting_LostFocus" KeyDown="NumericSetting_KeyDown" AutomationProperties.Name="Интервал проверки в секундах"/></StackPanel>
                            </Grid>
                            <TextBlock x:Name="ValidationMessage" Visibility="Collapsed" Foreground="#FFAAAA" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <CheckBox x:Name="RestoreCheck" Content="Возвращать приложения после игры" Click="RestoreCheck_Click" ToolTip="Повторный запуск подходящих приложений свёрнутыми; прежнее состояние не восстанавливается" Margin="0,8,0,0"/>
                            <CheckBox x:Name="ForceCheck" Click="ForceCheck_Click" ToolTip="После попытки обычного закрытия принудительное завершение может потерять несохранённые данные" Margin="0,8,0,0"><TextBlock Text="Завершать, если обычное закрытие не помогло" TextWrapping="Wrap" FontSize="12"/></CheckBox>
                            <Border Background="#1B1B1B" CornerRadius="12" Padding="11" Margin="0,14,0,0">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="../Assets/Brand/exclamation.png" Width="22" Height="22" VerticalAlignment="Top"/><TextBlock Grid.Column="1" Text="Игра, Windows, службы и исключения защищены. Сохраните работу перед включением." FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="0.78*"/><RowDefinition Height="14"/><RowDefinition Height="1.22*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="20,18">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel><StackPanel Orientation="Horizontal"><ui:MaterialIcon Kind="shield" Width="21" Height="21" Margin="0,0,9,0"/><TextBlock Text="Исключения" FontSize="20" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="ExclusionCount" Text="0 правил" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
                            <DockPanel Grid.Row="1" Margin="0,10,0,12">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Click="AddExclusionProcess_Click" Margin="0,0,7,0" ToolTip="Выбрать из запущенных процессов" AutomationProperties.Name="Добавить запущенный процесс в исключения"><StackPanel Orientation="Horizontal"><ui:MaterialIcon Kind="add" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Процесс" FontSize="12"/></StackPanel></Button>
                                    <Button Click="AddExclusionFile_Click" ToolTip="Выбрать исполняемый файл" AutomationProperties.Name="Добавить исполняемый файл в исключения"><StackPanel Orientation="Horizontal"><ui:MaterialIcon Kind="folder_open" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text=".exe" FontSize="12"/></StackPanel></Button>
                                </StackPanel>
                                <TextBlock Text="Эти приложения остаются открытыми" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            </DockPanel>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ExclusionRows"/></ScrollViewer>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20,18">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel><StackPanel Orientation="Horizontal"><ui:MaterialIcon Kind="sports_esports" Width="23" Height="23" Margin="0,0,9,0"/><TextBlock Text="Запускать режим при обнаружении" FontSize="19" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="GameCount" Text="3 игры" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
                            <DockPanel Grid.Row="1" Margin="0,10,0,12">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Click="AddGameProcess_Click" Margin="0,0,7,0" AutomationProperties.Name="Добавить игру из запущенных процессов"><StackPanel Orientation="Horizontal"><ui:MaterialIcon Kind="add" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="Процесс" FontSize="12"/></StackPanel></Button>
                                    <Button Click="AddGameFile_Click" AutomationProperties.Name="Добавить исполняемый файл игры"><StackPanel Orientation="Horizontal"><ui:MaterialIcon Kind="folder_open" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text=".exe" FontSize="12"/></StackPanel></Button>
                                </StackPanel>
                                <TextBlock Text="По файлу процесса · детект можно отключить" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            </DockPanel>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="GameRows"/></ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,9">
                <TabControl x:Name="ActivityTabs" Background="Transparent" BorderThickness="0" Foreground="#F0F0F0">
                    <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TabPanel IsItemsHost="True"/><ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="8,12,8,0"/></Grid></ControlTemplate></TabControl.Template>
                    <TabItem x:Name="RestoreTab" Header="Возврат приложений">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Подходящие приложения вернутся свёрнутыми. Документы и прежнее состояние могут не вернуться." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,9" TextWrapping="Wrap"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="RestoreRows"/></ScrollViewer></Grid>
                    </TabItem>
                    <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><ui:MaterialIcon Kind="article" Width="16" Height="16" Fill="#BBBBBB" Margin="0,0,6,0"/><TextBlock Text="Журнал" FontSize="13"/></StackPanel></TabItem.Header>
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,8"><Button Click="OpenLogDirectory_Click" DockPanel.Dock="Right" Padding="9,5" AutomationProperties.Name="Открыть папку журнала"><StackPanel Orientation="Horizontal"><ui:MaterialIcon Kind="folder_open" Width="15" Height="15" Margin="0,0,6,0"/><TextBlock Text="Папка журнала" FontSize="11"/></StackPanel></Button><TextBlock x:Name="LogLocation" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="LogRows"/></ScrollViewer></Grid>
                    </TabItem>
                    <TabItem><TabItem.Header><StackPanel Orientation="Horizontal"><ui:MaterialIcon Kind="info" Width="16" Height="16" Fill="#BBBBBB" Margin="0,0,6,0"/><TextBlock Text="О приложении" FontSize="13"/></StackPanel></TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                            <TextBlock Text="Game Mode · ваш компьютер, ваша игра" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Working Set — объём физической памяти процесса. Сумма памяти закрытых процессов — оценка. Закрытие окна оставляет программу в трее; для завершения выберите «Выход»." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,10"/>
                            <StackPanel Orientation="Horizontal"><Button Click="CheckUpdates_Click"><StackPanel Orientation="Horizontal"><ui:MaterialIcon Kind="download" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock Text="Проверить обновления" FontSize="12"/></StackPanel></Button><Button Content="Лицензии" Click="ShowLicense_Click" Margin="7,0,0,0"/><Button Content="Предупреждение" Click="ShowWarning_Click" Margin="7,0,0,0"/><TextBlock x:Name="UpdateMessage" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="550"/></StackPanel>
                        </StackPanel></ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>
