<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>GameMode</AssemblyName>
    <RootNamespace>GameMode.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.1</Version>
    <InformationalVersion>0.1.1-beta</InformationalVersion>
    <ApplicationIcon>Tray/Assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../GameMode.Core/GameMode.Core.csproj" />
    <None Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Tray/Assets/*.ico" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets/Brand/*.png" />
    <Resource Include="Assets/Material/*.svg" />
    <None Update="Assets/Material/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
